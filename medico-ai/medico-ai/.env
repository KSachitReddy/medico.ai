# Medico.AI Environment Variables
# Copy this file to .env and fill in your values.

# ── Backend API URL (consumed by Streamlit frontend) ─────────────────────────
MEDICO_API_URL=http://localhost:8000/api/v1

# ── Database (SQLite default — change to PostgreSQL for production) ───────────
DATABASE_URL=sqlite:///./medico.db
# DATABASE_URL=postgresql://user:password@localhost:5432/medicodb

# ── Tesseract binary path (Windows users may need this) ──────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── LLM API Keys (required for AI features) ───────────────────────────────────
# At least one key is needed for: AI chat, drug interaction checks,
# medicine explanations, and LLM-powered NLP fallback.

# Option 1 — Anthropic Claude (recommended: fast, affordable, great for medical NLP)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model to use (default: claude-haiku-4-5-20251001 — fast & cheap)
# Options: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Option 2 — OpenAI (optional fallback if Anthropic key is not set)
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
